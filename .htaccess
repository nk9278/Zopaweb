# Protect core and sensitive directories if deployed at project root
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(config|database|includes|admin/includes|storage|logs|backups)(/.*)?$ - [F,L]
</IfModule>

# Block directory listings
Options -Indexes

# Deny access to sensitive files
<FilesMatch "\.(sql|env|ini|log)$">
    Require all denied
</FilesMatch>
